# Required for the Docker deployment.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Paste the Neon connection string from its Connect dialog. The application
# automatically selects the psycopg driver and keeps sslmode=require intact.
DATABASE_URL=postgresql://USER:PASSWORD@EP-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# The reverse proxy terminates HTTPS, so production cookies must stay secure.
SESSION_COOKIE_SECURE=true

# Leave unset for same-origin Socket.IO only. Add a comma-separated allowlist
# only if a separately hosted frontend is introduced later.
# SOCKETIO_CORS_ORIGINS=https://ugac.iitmandi.ac.in
